# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- Qlib 数据（大型第三方数据集，不提交；可用脚本重新下载） ---
qlib_data/
qlib_data_old/
qlib_data_prev/
qlib_data_prev_*/
mlruns/

# --- 数据层：逐层放行（git 不进被排除的目录，所以必须按父目录排除）---
# 默认忽略 data 下的一切，再显式放行要入库的子目录
data/*
!data/parquet/
!data/derived/
!data/quant/

# canonical 数据（行情/证券/日历/估值/行业/公司行为）—— 入库
!data/parquet/**

# derived 默认忽略，只放行研究快照
data/derived/*
!data/derived/factors/
!data/derived/news/
!data/derived/labels/
!data/derived/audit/
# Alpha158 特征月度缓存（357MB，可由 canonical 重算）
data/derived/features/
# 临时目录
data/derived/tmp/

# 量化运行产物（信号/预测/交易计划/job 记录）—— 入库
!data/quant/**

# 单文件超 GitHub 100MB 硬限制，且可由 parquet 重建
data/duckdb/
# 原始 HTTP 响应缓存（可重新抓取）
data/raw/
# 个人真实资产数据，按设计不出本机
data/wealth/

# --- 日志与临时文件 ---
logs/
*.log
tmp/
temp/
*.tmp
*.zip
*.tar.gz

# --- 报告产物（可再生成；如需保留请显式 add -f） ---
# reports/ 保留 README 类说明文件，实验产物按需提交

# --- IDE / 编辑器 ---
.vscode/
.idea/
*.swp

# --- 系统文件 ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Claude 本地配置 ---
.claude/settings.local.json

# --- 模型：全部入库（每个 40-70KB；S3 生产模型是推荐的来源，必须可复现）---
# 曾经忽略 experiments/**/model.txt —— 已改为入库，见 数据与模型清单.md

# --- STEP 3/6: 大型可再生成产物 ---
experiments/**/walkforward_predictions.parquet
experiments/**/walkforward/model_q*.txt

# --- STEP 4: 大型可再生成产物 ---
experiments/factors/**/factor_dashboard_data.parquet
experiments/factors/**/beam.json

# --- STEP 6: large regenerable artifacts (portfolio) ---
experiments/portfolio/**/*.parquet
experiments/news/strategy/research_model_*.txt
experiments/news/strategy/research_predictions_*.parquet

# --- STEP 7: personal wealth data (user data; never in git) ---
data/wealth/
backup/

# --- STEP 10: forward holdout 观测数据（spec §51）---
# 引擎/配置/测试/文档/报告入库；逐日的 predictions/portfolio/trades/metrics
# 是可再生成的大 parquet，不入库。reports/forward_holdout/*.md 入库。
forward_holdout/predictions/
forward_holdout/portfolio/
forward_holdout/trades/
forward_holdout/metrics/
forward_holdout/manifests/
forward_holdout/observations/
forward_holdout/alerts/
forward_holdout/state/
forward_holdout/dashboard/

# 历史引擎验证产物（可由 scripts/paper_live/validate_engine.py 重跑）
experiments/paper_live/

# --- 密钥（绝不入库，绝不出现在日志/报告/database）---
.env
.env.*
*.key
secrets*

# news v1 快照（37MB，v1 表本身仍在库里；这份只是留证，没必要入库）
data/derived/news/v1_snapshot/

# news v2 事件快照（115MB，**超过 GitHub 单文件 100MB 硬上限**，推不上去）。
# 它是纯派生物：库里 news_documents_v2 是源头，一条命令重建：
#     python scripts/news/build_events.py --version v2
# 同目录下的 pack / coverage / factor store 都很小，正常入库。
data/derived/news/news_events_v2.parquet

# 研究层的事件缓存（66MB，加了 taxonomy 的派生表）。纯缓存：
# 库里 news_events_v2 是源头，`load_research_events(rebuild=True)` 17 秒重建。
# 同目录的 .taxonomy.json（版本戳）和 news_factor_daily.parquet（研究产出）
# 都很小，正常入库。
data/derived/news/news_events_research.parquet
